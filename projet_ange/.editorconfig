root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.php]
indent_size = 4

[*.sql]
indent_size = 4

[*.yml]
indent_size = 2

[*.yaml]
indent_size = 2

[Dockerfile]
indent_size = 4

[*.sh]
end_of_line = lf
indent_size = 2

[.env]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
